dist/
build/
.env
.env.bak.*
/data/
/logs/
# The DGX model cache is a host-mounted vLLM asset. Sending it as part of the
# Prisma backend build context can add tens of gigabytes without affecting the
# image.
/deploy/dgx-spark/cache/
.git/
# Bundle only the immutable Council skill packages. Other .claude state can
# contain local settings/session data and must never enter the image.
.claude/*
.playwright-mcp/
.pytest_cache/
.vscode/
.idea/
dev-docs/
docs/
*.md
*.db
*.sqlite
*.sqlite3
