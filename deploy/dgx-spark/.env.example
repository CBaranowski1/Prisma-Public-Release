# Copy to .env on the DGX Spark. Never commit the populated file.
DGX_VLLM_IMAGE=vllm/vllm-openai@sha256:ffb2d59b1c059a5bd8d781320c9f5189de8293693b7d95da54befddaa54abf52
DGX_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4
DGX_MODEL_REVISION=491c2f1ea524c639598bf8fa787a93fed5a6fbce
DGX_API_KEY=replace-with-a-long-random-secret
DGX_BIND=127.0.0.1
DGX_PORT=8000
DGX_UID=1000
DGX_GID=1000
DGX_HF_CACHE=./cache
DGX_GPU_MEMORY_UTILIZATION=0.30
DGX_MAX_MODEL_LEN=32768
DGX_MAX_NUM_SEQS=2
DGX_MAX_NUM_BATCHED_TOKENS=4096
# The public NVIDIA checkpoint downloads anonymously; no HF_TOKEN is used.
# Set to 1 only after the first successful model download.
HF_HUB_OFFLINE=0
