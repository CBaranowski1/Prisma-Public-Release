# Data — all user data stays local. The curated system-skill packages are
# source assets, not user data, and must survive a clean checkout.
/data/*
!/data/skills/
/data/skills/*
!/data/skills/system/
!/data/skills/system/**
!services/hwfit/data/
!services/hwfit/data/hf_models.json
logs/
*.log
# Belt-and-suspenders explicit entry (already covered by *.log above) —
# runtime search-engine error log, never committed (GRAY-INT-12).
services/search_engine_error.log
*.db
*.sqlite
*.sqlite3
*.dump
*.backup
*.bak
*.old

# Node
node_modules/
services/node_modules/
services/data/

# IDE / Editor
.aider*
.claude/*
# Version-control the council/agent skills so a clean checkout reproduces the
# "27 skills wired" claim (v2.0 VERIFY-05/07); everything else under .claude/ stays local.
!.claude/skills/
.vscode/
.idea/
*.swp
*.swo
*~

# Test capture artifacts (browser session dumps may contain personal content)
.playwright-mcp/

# OS
.DS_Store
Thumbs.db

# Build artifacts
*.cache
cache/
output.txt.txt
*.tar.gz
*.tgz
*.zip

